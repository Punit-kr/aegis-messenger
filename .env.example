# Aegis Environment Variables Configuration Template
# NOTE: Secrets must NEVER be checked into version control.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
WEB_PORT=3000

# Authentication & Cryptographic Tokens
JWT_SECRET=your_super_secure_random_jwt_secret_at_least_32_bytes_hex
REFRESH_SECRET=your_super_secure_random_refresh_token_secret_32_bytes_hex

# CORS Configuration
CORS_ORIGIN=*

# Storage
DATABASE_FILE=/app/apps/backend/data/aegis.sqlite
MEDIA_DIR=/app/apps/backend/data/media

# OAuth Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.aegis.messenger.client

# Carrier SMS Gateway (Options: 'mock' for local dev/testing, 'twilio' for production)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
